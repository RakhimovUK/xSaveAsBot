lang-pick = 🌐 Tilni tanlang / Выберите язык / Choose language
lang-name = Русский
lang-changed = ✅ Язык изменён: Русский

welcome =
    👋 Привет, { $name }!

    Я <b>xSaveAsBot</b> — отправьте ссылку, и я пришлю медиафайл.

    <b>Основные платформы:</b> Instagram, YouTube, TikTok, Threads, Pinterest
    <b>Дополнительно:</b> Facebook, X/Twitter, Snapchat, Likee, VK, SoundCloud, Spotify, Reddit, Twitch, Vimeo

    🎵 Распознавание песен, 🔎 поиск музыки, 📝 тексты песен, 🎧 MP3 из видео.
    Работаю в группах и в темах форумов.

    /lang — сменить язык · /help — помощь

help =
    ℹ️ <b>Как пользоваться</b>

    • Отправьте ссылку — я пришлю медиа.
    • Обычный текст — поиск песни.
    • Голосовое или видео — распознавание песни.
    • Добавьте в группу: бот отвечает на ссылки в той же теме.

    /lang — сменить язык

echo = 🔁 Эхо: { $text }
where =
    📍 chat_id: <code>{ $chat_id }</code>
    🧵 thread: <code>{ $thread }</code>
    ↩️ reply_to: <code>{ $reply_to }</code>

admin-only = ⛔ Эта команда только для админов.
ping-sent = ⏳ Пинг отправлен воркеру…
ping-ok = ✅ Воркер ответил: { $result } ({ $ms } мс)
ping-fail = ❌ Воркер не ответил: { $error }
testupload-sent = ⏳ Юзербот загружает тестовый файл в канал-хранилище…
testupload-fail = ❌ Ошибка загрузчика: { $error }
testupload-done = ✅ Пришло из канала-хранилища. file_id: <code>{ $file_id }</code>
userbot-status = 🤖 Юзербот: { $status }

status-analyzing = ⏳ Анализирую…
status-downloading = ⏳ Скачиваю…
status-uploading = ⏳ Загружаю в Telegram…
status-relay = ⏳ Получаю через другой источник…
status-queued-shared = ⏳ Этот файл уже готовится, скоро пришлю…
picker-title =
    🎬 <b>{ $title }</b>

    Выберите качество:
    🚀 готово (мгновенно) · ⚡ будет готовиться
unsupported-link = 🤷 Эта ссылка не поддерживается.
send-link-hint = 🔗 Отправьте ссылку (Instagram, YouTube, TikTok, Threads, Pinterest и другие).
err-unsupported = 🤷 Эта ссылка не поддерживается.
err-disabled = 🚧 Эта платформа временно отключена.
err-private = 🔒 Контент закрытый (private), скачать нельзя.
err-notfound = 🗑 Контент не найден или удалён.
err-age = 🔞 Контент с возрастным ограничением, скачать нельзя.
err-toolarge = 📦 Файл слишком большой.
err-toolong = ⏱ Видео слишком длинное.
err-unavailable = 😕 Эта платформа сейчас временно недоступна. Попробуйте позже.
err-budget = 📉 Дневной лимит исчерпан. Попробуйте завтра.
err-ratelimit = ⏳ Слишком много запросов, подождите минуту.
err-nostorage = ⚠️ Файл подготовлен, но доставить не удалось. Попробуйте ещё раз.
err-generic = ❌ Произошла ошибка. Попробуйте позже.
caption-more-formats = ещё форматы →
status-relay-quality = ⏳ Готовлю { $quality }, это может занять 30–60 секунд…
picker-prompt =
    Выберите качество ↓
    🚀 готово (мгновенно) · ⚡ будет готовиться
