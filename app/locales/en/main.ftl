lang-pick = 🌐 Tilni tanlang / Выберите язык / Choose language
lang-name = English
lang-changed = ✅ Language changed: English

welcome =
    👋 Hi, { $name }!

    I'm <b>xSaveAsBot</b> — send me a link and I'll send the media back.

    <b>Core platforms:</b> Instagram, YouTube, TikTok, Threads, Pinterest
    <b>Extra:</b> Facebook, X/Twitter, Snapchat, Likee, VK, SoundCloud, Spotify, Reddit, Twitch, Vimeo

    🎵 Song recognition, 🔎 music search, 📝 lyrics, 🎧 MP3 from video.
    I work in groups and forum topics too.

    /lang — change language · /help — help

help =
    ℹ️ <b>How to use</b>

    • Send a link — I'll send the media.
    • Plain text — song search.
    • Voice message or video — song recognition.
    • Add me to a group: I answer links in the same topic.

    /lang — change language

echo = 🔁 Echo: { $text }
where =
    📍 chat_id: <code>{ $chat_id }</code>
    🧵 thread: <code>{ $thread }</code>
    ↩️ reply_to: <code>{ $reply_to }</code>

admin-only = ⛔ This command is for admins only.
ping-sent = ⏳ Ping sent to the worker…
ping-ok = ✅ Worker replied: { $result } ({ $ms } ms)
ping-fail = ❌ Worker did not reply: { $error }
testupload-sent = ⏳ The userbot is uploading a test file to the storage channel…
testupload-fail = ❌ Uploader error: { $error }
testupload-done = ✅ Arrived from the storage channel. file_id: <code>{ $file_id }</code>
userbot-status = 🤖 Userbot: { $status }

status-analyzing = ⏳ Analyzing…
status-downloading = ⏳ Downloading…
status-uploading = ⏳ Uploading to Telegram…
status-relay = ⏳ Fetching via another source…
status-queued-shared = ⏳ This file is already being prepared, it will arrive shortly…
picker-title =
    🎬 <b>{ $title }</b>

    Choose quality:
unsupported-link = 🤷 This link is not supported.
