# Copy to .env and fill in. Never commit .env.

# --- Telegram bot ---
BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs
ADMIN_IDS=111111111
DEFAULT_LANG=uz
# polling | webhook (webhook is wired in Phase 9)
MODE=polling
WEBHOOK_URL=

# --- Userbot (MTProto, owned by the uploader service only) ---
TG_API_ID=12345
TG_API_HASH=0123456789abcdef0123456789abcdef
# Comma-separated Telethon StringSessions (generate with scripts/make_session.py)
USERBOT_SESSIONS=

# --- Storage channels (bot + userbot must be admins in all of them) ---
# JSON map platform -> channel id
STORAGE_CHANNELS={}
STORAGE_CHANNEL_DEFAULT=-1001234567890
INBOX_CHANNEL=

# --- Infra ---
# Docker compose overrides these with in-network hosts
DATABASE_URL=postgresql+asyncpg://xsaveasbot:xsaveasbot@localhost:5432/xsaveasbot
REDIS_URL=redis://localhost:6379/0

# --- Limits (used from Phase 2) ---
MAX_DURATION_MIN=180
MAX_SELF_UPLOAD_MB=1900
RELAY_THRESHOLD_MB=50
RELAY_TIMEOUT_S=120
EGRESS_DAILY_BUDGET_GB=5
USER_RATE_LIMIT=10
WORKER_CONCURRENCY=4
UPLOADER_CONCURRENCY=2

# --- Feature flags ---
PLATFORMS_ENABLED=instagram,youtube,tiktok,threads,pinterest
FEATURE_LYRICS=true
FEATURE_RELAY=true
RELAY_TIER2=false
FEATURE_URL_SEND=true
FEATURE_MANDATORY_SUB=false
FEATURE_ADS=false
FEATURE_PREMIUM=false
# Phase 1 only: echo every text message back (topic routing test)
FEATURE_ECHO=true

# --- Anti-blocking (later phases) ---
INSTAGRAM_SESSIONS_DIR=./secrets/instagram
YT_COOKIES_PATH=
PROXY_URL_INSTAGRAM=
PROXY_URL_YOUTUBE=

# --- Monitoring ---
SENTRY_DSN=
LOG_LEVEL=INFO
